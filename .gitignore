# ============================================================
# .gitignore — «Писательский трекер»
# В репозиторий попадают только исходники приложения и документация
# ============================================================

# --- Резервные копии данных приложения (создаются через «Скачать JSON») ---
writer-tracker-backup-*.json
writer-tracker-backup*.json
*.backup.json
backups/
*.bak

# --- Временные и служебные файлы ---
*.tmp
*.temp
*.log
*.swp
*~
~$*

# --- Кеши и мусор ОС / браузеров ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Редакторы и IDE ---
.vscode/
.idea/
*.code-workspace
*.sublime-*

# --- Локальные окружения и зависимости (приложению не нужны) ---
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# --- Профили и дампы автотестов (если появятся локально) ---
/tmp/
/profile/
*.cpuprofile
*.heapsnapshot